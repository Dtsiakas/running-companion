{
  "name": "running-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node packages/server/src/main.ts",
    "up": "node --disable-warning=ExperimentalWarning packages/cli/src/up.ts",
    "down": "node --disable-warning=ExperimentalWarning packages/cli/src/down.ts",
    "demo": "node --disable-warning=ExperimentalWarning packages/cli/src/demo.ts",
    "set-password": "node packages/server/src/set-password.ts",
    "dev:web": "npm run dev -w @companion/web",
    "build": "npm run build -w @companion/web",
    "sync": "node packages/cli/src/sync.ts",
    "metrics": "node packages/cli/src/metrics.ts",
    "discover": "node packages/cli/src/discover.ts",
    "auth:check": "node packages/cli/src/auth-check.ts",
    "mcp": "node packages/mcp/src/server.ts",
    "mcp:install": "node packages/mcp/src/install.ts",
    "mcp:doctor": "node packages/mcp/src/doctor.ts",
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "license": "AGPL-3.0-or-later"
}
