{
  "name": "running-companion",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node packages/server/src/main.ts",
    "demo": "node --disable-warning=ExperimentalWarning packages/cli/src/demo.ts",
    "set-password": "node packages/server/src/set-password.ts",
    "dev:web": "npm run dev -w @companion/web",
    "build": "npm run build -w @companion/web",
    "sync": "node packages/cli/src/sync.ts",
    "backup": "node --disable-warning=ExperimentalWarning packages/cli/src/backup.ts",
    "restore": "node --disable-warning=ExperimentalWarning packages/cli/src/restore.ts",
    "metrics": "node packages/cli/src/metrics.ts",
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "license": "AGPL-3.0-or-later"
}
