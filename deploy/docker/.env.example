# Copy to .env next to the compose files. Everything here is optional unless the compose file you use says otherwise.
# The password and Garmin key are not set here: the app asks for them on its setup page and keeps them in its volume.

# Your time zone: the scheduled syncs and "today" follow it.
TZ=Europe/Athens

# Pin a release instead of following the newest one, e.g. 0.1.0. "edge" follows the main branch.
# COMPANION_TAG=latest

# compose.caddy.yaml: your domain, pointed at this server.
# DOMAIN=running.example.com

# compose.tailscale.yaml: an auth key from the Tailscale admin console, the machine's name, and the address it gets.
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=companion
# PUBLIC_URL=https://companion.your-tailnet.ts.net

# Optional: CARTO basemaps key for nicer maps (see the main README).
# CARTO_API_KEY=

# Optional: sync hours (local time), comma-separated.
# SYNC_HOURS=6,8,10,12,14,16,18,20,22
