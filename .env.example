# Optional. Nothing here is needed to start: the app asks for a password and your Garmin key on its setup page and
# keeps them in data/settings.json. Copy this file to .env only to change how the server runs. Never commit .env.

# Settings normally made in the app. Set here, they win and the app shows them as locked.
# GARMIN_PERSONAL_API_KEY=
# PASSWORD_HASH=                        scrypt hash, not the password (npm run set-password makes one)
# SESSION_SECRET=                       32+ random characters; the app creates one if unset
# COMPANION_DATA_DIR=./data             where the database and settings live (a Docker volume, say)

# Web server (optional; defaults shown)
# PUBLIC_URL=http://localhost:8787      the address you and Claude use, e.g. https://companion.your-tailnet.ts.net
# PORT=8787
# HOST=127.0.0.1                        only reachable through the tunnel/proxy in front of it
# TRUST_PROXY=false                     true when a proxy (Tailscale, Caddy) sits in front
# SYNC_HOURS=6,8,10,12,14,16,18,20,22   local hours for the scheduled Garmin sync
# TZ=Europe/Athens                      time zone for SYNC_HOURS (set it on the server)

# Optional overrides
# GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com

# Maps (optional). Without a key the maps use OpenStreetMap's tiles. With a free CARTO basemaps key (personal use,
# no account: https://carto.com/basemaps/apikey/) they use CARTO's light and dark maps, which match the app better.
# CARTO_API_KEY=
